# Local SQLite Development Database
DATABASE_URL="file:./dev.db"

# Authentication & Session Security
JWT_SECRET="gdgu-super-secret-jwt-key-2026-production-ready"
DEFAULT_FACULTY_PASSCODE="gdgu@2026"
ADMIN_PASSCODE="admin@gdgu2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Student Sign-in)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Cloudflare Production Bindings (Configured via wrangler.jsonc in production)
# D1 Database: gdgu_idp_db
# R2 Storage: gdgu-idp-artifacts
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="gdgu-idp-artifacts"

# Optional SMS / OTP Integration
TWO_FACTOR_API_KEY="your-2factor-api-key"
